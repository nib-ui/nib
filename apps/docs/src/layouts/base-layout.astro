---
import '@nib-ui/fonts/fonts.css';
import '@nib-ui/css/nib.css';
import '../styles/docs.css';
import SiteHeader from '../components/site-header.astro';
import PageOutline from '../components/page-outline.astro';
import { href, navigation } from '../data/nav.ts';
import { strings } from '../i18n/ui.ts';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = Astro.currentLocale ?? 'en';
const t = strings(lang);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <!-- First stylesheet of the page: bundlers drop a bare layer statement from CSS files, and it
         alone fixes the order of the layers for everything after it. -->
    <style is:inline>
      @layer nib.theme, nib.base, nib.components, nib.utilities;
    </style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Nib' ? title : `${title} · Nib`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a stored theme and density before first paint; without one the page follows the OS.
      try {
        const theme = localStorage.getItem('nib-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        const density = localStorage.getItem('nib-density');
        if (density === 'compact' || density === 'comfortable') document.documentElement.dataset.density = density;
      } catch {}
    </script>
  </head>
  <body>
    <a class="nib-skip" href="#content">
      {t.skip}
    </a>
    <SiteHeader />
    <div class="nib-with-side docs-shell">
      <div class="docs-side">
        <div class="docs-side__inner">
          <PageOutline />
          <details class="docs-contents" open>
            <summary class="nib-side-nav__title">{t.contents}</summary>
            <nav class="nib-side-nav" aria-label={t.docsNav}>
              {navigation().map((group) => (
                <>
                  <p class="nib-side-nav__title">{group.title}</p>
                  <ul role="list">
                    {group.pages.map((page) => (
                      <li>
                        <a href={href(page.slug)} aria-current={path === href(page.slug) ? 'page' : undefined}>
                          {page.title}
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              ))}
            </nav>
          </details>
        </div>
      </div>
      <main id="content" class="nib-with-side__main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script is:inline>
      // On narrow screens the side column sits above the page: its contents start closed. Widening
      // the window opens them again, since the wide layout has no CONTENTS toggle.
      (() => {
        const narrow = matchMedia('(width < 48rem)');
        const contents = document.querySelector('.docs-contents');
        const apply = () => contents && (contents.open = !narrow.matches);
        apply();
        narrow.addEventListener('change', apply);
      })();
    </script>
  </body>
</html>
