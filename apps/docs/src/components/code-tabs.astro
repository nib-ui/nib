---
import { strings } from '../i18n/ui.ts';

/** One code sample per framework; empty ones are left out. */
interface Props {
  html?: string;
  react?: string;
  vue?: string;
  svelte?: string;
}

const t = strings(Astro.currentLocale);
const id = `code-${Math.random().toString(36).slice(2, 8)}`;
const samples = (['html', 'react', 'vue', 'svelte'] as const)
  .map((name) => ({ name, code: Astro.props[name] }))
  .filter((s): s is { name: (typeof s)['name']; code: string } => !!s.code);
---

<div class="docs-tabs" data-code-tabs>
  <div class="docs-tablist" role="tablist" aria-label={t.code}>
    {samples.map((s, i) => (
      <button
        type="button"
        class="docs-tab"
        role="tab"
        id={`${id}-tab-${s.name}`}
        aria-controls={`${id}-panel-${s.name}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {s.name.toUpperCase()}
      </button>
    ))}
  </div>
  {samples.map((s, i) => (
    <div
      class="docs-tabpanel"
      role="tabpanel"
      id={`${id}-panel-${s.name}`}
      aria-labelledby={`${id}-tab-${s.name}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <pre>
          <code>{s.code}</code>
        </pre>
    </div>
  ))}
</div>

<script>
  import '../scripts/code-tabs.ts';
</script>
