---
import ThemeToggle from './theme-toggle.astro';
import DensityToggle from './density-toggle.astro';
import { strings } from '../i18n/ui.ts';

const t = strings(Astro.currentLocale);
const path = Astro.url.pathname;
const links = [
  { href: '/components/', label: t.components },
  { href: '/play/', label: t.play },
];
---

<header class="nib-header">
  <div class="nib-header__bar">
    <a class="nib-header__brand" href="/">
      {t.home}
    </a>
    <ul class="nib-nav" id="site-nav" aria-label={t.siteNav}>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <span class="nib-header__word docs-search" aria-disabled="true">
      {t.search}
    </span>
    <DensityToggle />
    <ThemeToggle />
    <a class="nib-header__word nib-header__menu" href="#site-nav">
      {t.menu}
    </a>
  </div>
</header>
