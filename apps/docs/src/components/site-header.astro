---
import ThemeToggle from './theme-toggle.astro';
import DensityToggle from './density-toggle.astro';
import { strings } from '../i18n/ui.ts';

const t = strings(Astro.currentLocale);
const path = Astro.url.pathname;
// `section` is the path a link stands for: on any page under it the link is the current section.
const links = [
  { href: '/guides/install/', section: '/guides/', label: t.guides },
  { href: '/components/', section: '/components/', label: t.components },
  { href: '/play/', section: '/play/', label: t.play },
];
---

<header class="nib-header">
  <div class="nib-header__bar">
    <a class="nib-header__brand" href="/">
      {t.home}
    </a>
    <nav class="nib-nav" id="site-nav" aria-label={t.siteNav}>
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? 'page' : path.startsWith(link.section) ? 'true' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <span class="nib-header__word docs-search">{t.search}</span>
    <DensityToggle />
    <ThemeToggle />
    <a class="nib-header__word nib-header__menu" href="#site-nav">
      {t.menu}
    </a>
  </div>
</header>
