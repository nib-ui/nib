---
import BaseLayout from '../../layouts/base-layout.astro';
import { href, navigation } from '../../data/nav.ts';
---

<BaseLayout
  title="Components"
  description="Every Nib component, with a live example, its code and its accessibility notes."
>
  <p class="nib-kicker">Docs</p>
  <h1>Components</h1>
  {navigation().map((group) => (
    <section aria-labelledby={`group-${group.title}`} class="docs-index">
      <h2 id={`group-${group.title}`}>{group.title}</h2>
      <ul class="nib-grid" role="list" style="--nib-grid-min: 14rem">
        {group.pages.map((page) => (
          <li>
            <a class="nib-tile" href={href(page.slug)}>
              <span class="nib-tile__title">{page.title}</span>
              <span class="nib-text-small">{page.lead}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .docs-index {
    margin-block-start: var(--nib-space-2xl);
  }

  .docs-index h2 {
    margin-block-end: var(--nib-space-md);
  }

  .docs-index .nib-grid {
    max-inline-size: none;
    margin: 0;
    padding: 0;
  }
</style>
