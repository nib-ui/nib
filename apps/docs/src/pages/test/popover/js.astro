---
import FixtureLayout from '../../../layouts/fixture-layout.astro';
---

<FixtureLayout title="Popover · vanilla fixture">
  <div data-nib="popover" id="pp" class="fixture-popover">
    <button type="button" class="nib-button nib-button--outline" data-nib-trigger>
      Filters
    </button>
    <div class="nib-popover" data-nib-content>
      <button type="button" class="nib-button">
        Apply
      </button>
    </div>
  </div>
</FixtureLayout>

<script>
  import '@nib-ui/js/popover';
  import { init } from '@nib-ui/js';
  init();
</script>
