---
import FixtureLayout from '../../../layouts/fixture-layout.astro';
---

<FixtureLayout title="Dialog · vanilla fixture">
  <div data-nib="dialog" id="dl">
    <button type="button" class="nib-button nib-button--outline" data-nib-trigger>
      Archive
    </button>
    <dialog class="nib-dialog" data-nib-dialog>
      <div class="nib-dialog__header">
        <h2 class="nib-dialog__title" data-nib-title>
          Archive order #1042?
        </h2>
      </div>
      <p class="nib-dialog__body" data-nib-description>
        You can restore it from the archive later.
      </p>
      <div class="nib-dialog__footer nib-action-row">
        <button type="button" class="nib-button" data-nib-close>
          Cancel
        </button>
        <button type="button" class="nib-button nib-button--primary">
          Archive
        </button>
      </div>
    </dialog>
  </div>
</FixtureLayout>

<script>
  import '@nib-ui/js/dialog';
  import { init } from '@nib-ui/js';
  init();
</script>
