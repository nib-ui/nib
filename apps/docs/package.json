{
  "name": "@nib-ui/docs",
  "version": "0.0.0",
  "description": "Nib documentation site",
  "license": "MIT",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "scope:private"
    ],
    "targets": {
      "build": {
        "command": "astro build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "!{projectRoot}/e2e/**/*",
          "!{projectRoot}/playwright.config.ts",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "dev": {
        "command": "astro dev",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      },
      "typecheck": {
        "command": "astro check --tsconfig tsconfig.astro.json && tsc -p tsconfig.e2e.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ]
      },
      "e2e": {
        "command": "playwright test",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production",
          {
            "externalDependencies": [
              "@playwright/test",
              "playwright",
              "@axe-core/playwright"
            ]
          },
          "{workspaceRoot}/scripts/playwright-docker.sh"
        ],
        "outputs": [
          "{projectRoot}/test-results",
          "{projectRoot}/playwright-report"
        ]
      }
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@nib-ui/core": "workspace:*",
    "@nib-ui/css": "workspace:*",
    "@nib-ui/fonts": "workspace:*",
    "@nib-ui/js": "workspace:*",
    "@nib-ui/react": "workspace:*",
    "@nib-ui/svelte": "workspace:*",
    "@nib-ui/tokens": "workspace:*",
    "@nib-ui/vue": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/svelte": "9.1.1",
    "@astrojs/vue": "7.1.2",
    "@nib-ui/test-harness": "workspace:*",
    "@playwright/test": "1.64.1"
  }
}
