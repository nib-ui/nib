{
  "name": "@nib-ui/playground",
  "version": "0.0.0",
  "description": "Nib proof press: a playground for components and tokens",
  "license": "MIT",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:app",
      "scope:private"
    ],
    "targets": {
      "build": {
        "command": "vite build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "dependencies": {
    "@nib-ui/color-engine": "workspace:*",
    "@nib-ui/css": "workspace:*",
    "@nib-ui/fonts": "workspace:*",
    "@nib-ui/js": "workspace:*",
    "@nib-ui/tokens": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
