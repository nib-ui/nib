{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "vitest/importMeta"
    ],
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.mts",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
