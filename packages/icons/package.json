{
  "name": "@nib-ui/icons",
  "version": "1.0.0-rc.0",
  "description": "Nib icon set",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/icons"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:asset",
      "scope:public"
    ],
    "targets": {
      "build": {
        "command": "node scripts/build-icons.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.svg",
          "{projectRoot}/scripts/build-icons.ts",
          "{projectRoot}/scripts/check-icon.ts"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.css": "./dist/icons.css",
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./*": {
      "types": "./dist/esm/*.d.ts",
      "default": "./dist/esm/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts"
}
