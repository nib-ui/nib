{
  "name": "@nib-ui/cli",
  "version": "1.0.0-rc.0",
  "description": "Nib command-line tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/nib.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:cli",
      "scope:public"
    ],
    "targets": {
      "build": {
        "command": "vite build",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "cache": true
      }
    }
  },
  "bin": {
    "nib": "./dist/nib.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nib-ui/tokens": "workspace:*",
    "stylelint": "^17.16.0"
  },
  "devDependencies": {
    "@nib-ui/color-engine": "workspace:*",
    "@nib-ui/stylelint-plugin": "workspace:*"
  }
}
