{
  "name": "@nib-ui/tokens",
  "version": "1.0.0-alpha.0",
  "description": "Nib design tokens (DTCG source, CSS variables, Tailwind theme, JSON)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nib-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:tokens",
      "scope:public"
    ],
    "targets": {
      "emit": {
        "command": "node scripts/emit-tokens.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [],
        "inputs": [
          "{projectRoot}/source/**/*",
          "{projectRoot}/scripts/**/*",
          "{projectRoot}/src/**/*.ts",
          "!{projectRoot}/src/**/*.spec.ts"
        ],
        "outputs": [
          "{projectRoot}/dist/tokens.css",
          "{projectRoot}/dist/tailwind.css",
          "{projectRoot}/dist/tokens.json"
        ],
        "cache": true
      },
      "build": {
        "dependsOn": [
          "^build",
          "emit"
        ]
      },
      "size-limit": {
        "command": "node ../../scripts/css-size.ts css=dist/tokens.css",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "{workspaceRoot}/size-budgets.json",
          "{workspaceRoot}/scripts/css-size.ts"
        ]
      }
    }
  },
  "sideEffects": [
    "*.css"
  ]
}
