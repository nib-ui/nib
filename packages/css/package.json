{
  "name": "@nib-ui/css",
  "version": "0.0.0",
  "description": "Nib CSS: base, components and utilities in cascade layers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/css"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:css",
      "scope:public"
    ],
    "targets": {
      "lint": {
        "command": "stylelint \"src/**/*.css\" --allow-empty-input",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.css",
          "{projectRoot}/stylelint.config.mjs",
          "^production"
        ]
      },
      "build": {
        "command": "node scripts/build-css.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.css",
          "{projectRoot}/scripts/*.ts",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "size-limit": {
        "command": "node ../../scripts/css-size.ts css=dist/nib.css utilities=dist/utilities.css $(for f in dist/components/*.css; do [ -e \"$f\" ] && printf \" module=%s\" \"$f\"; done)",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/dist/nib.css",
          "{projectRoot}/dist/utilities.css",
          "{workspaceRoot}/size-budgets.json",
          "{workspaceRoot}/scripts/css-size.ts"
        ]
      }
    }
  },
  "devDependencies": {
    "@nib-ui/stylelint-plugin": "workspace:*",
    "@nib-ui/tokens": "workspace:*"
  },
  "exports": {
    "./package.json": "./package.json",
    "./nib.css": "./dist/nib.css",
    "./components/*": "./dist/components/*",
    "./utilities.css": "./dist/utilities.css",
    "./utilities.json": "./dist/utilities.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ]
}
