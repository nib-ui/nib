{
  "name": "@nib-ui/css",
  "version": "0.0.0",
  "description": "Nib CSS: base, components and utilities in cascade layers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/css"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:css",
      "scope:public"
    ],
    "targets": {
      "lint": {
        "command": "stylelint \"src/**/*.css\" --allow-empty-input",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "{projectRoot}/src/**/*.css",
          "{projectRoot}/stylelint.config.mjs",
          "^production"
        ]
      }
    }
  },
  "devDependencies": {
    "@nib-ui/stylelint-plugin": "workspace:*"
  }
}
