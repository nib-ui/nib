{
  "name": "@nib-ui/fonts",
  "version": "1.0.0",
  "description": "Nib fonts: Inter and JetBrains Mono, variable, self-hosted",
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/fonts"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:asset",
      "scope:public"
    ],
    "targets": {
      "build": {
        "command": "node scripts/build-fonts.ts",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/build-fonts.ts",
          "{projectRoot}/package.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "exports": {
    "./package.json": "./package.json",
    "./fonts.css": "./dist/fonts.css",
    "./files/*": "./dist/files/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ]
}
