  "nx": {
    "tags": [
      "type:core",
      "scope:public"
    ],
    "targets": {
      "size-limit": {
        "command": "size-limit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "{projectRoot}/.size-limit.js",
