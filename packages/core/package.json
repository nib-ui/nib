{
  "name": "@nib-ui/core",
  "version": "0.0.0",
  "description": "Nib headless controllers: state, attributes and intents, no DOM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nib-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@nib-ui/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./listbox": {
      "@nib-ui/source": "./src/listbox/index.ts",
      "types": "./dist/listbox/index.d.ts",
      "default": "./dist/listbox/index.js"
    },
    "./listbox/apg": {
      "@nib-ui/source": "./src/listbox/listbox.apg.ts",
      "types": "./dist/listbox/listbox.apg.d.ts",
      "default": "./dist/listbox/listbox.apg.js"
    },
    "./disclosure": {
      "@nib-ui/source": "./src/disclosure/index.ts",
      "types": "./dist/disclosure/index.d.ts",
      "default": "./dist/disclosure/index.js"
    },
    "./disclosure/apg": {
      "@nib-ui/source": "./src/disclosure/disclosure.apg.ts",
      "types": "./dist/disclosure/disclosure.apg.d.ts",
      "default": "./dist/disclosure/disclosure.apg.js"
    },
    "./tabs": {
      "@nib-ui/source": "./src/tabs/index.ts",
      "types": "./dist/tabs/index.d.ts",
      "default": "./dist/tabs/index.js"
    },
    "./tabs/apg": {
      "@nib-ui/source": "./src/tabs/tabs.apg.ts",
      "types": "./dist/tabs/tabs.apg.d.ts",
      "default": "./dist/tabs/tabs.apg.js"
    },
    "./popover": {
      "@nib-ui/source": "./src/popover/index.ts",
      "types": "./dist/popover/index.d.ts",
      "default": "./dist/popover/index.js"
    },
    "./popover/apg": {
      "@nib-ui/source": "./src/popover/popover.apg.ts",
      "types": "./dist/popover/popover.apg.d.ts",
      "default": "./dist/popover/popover.apg.js"
    },
    "./place": {
      "@nib-ui/source": "./src/place/index.ts",
      "types": "./dist/place/index.d.ts",
      "default": "./dist/place/index.js"
    },
    "./tooltip": {
      "@nib-ui/source": "./src/tooltip/index.ts",
      "types": "./dist/tooltip/index.d.ts",
      "default": "./dist/tooltip/index.js"
    },
    "./tooltip/apg": {
      "@nib-ui/source": "./src/tooltip/tooltip.apg.ts",
      "types": "./dist/tooltip/tooltip.apg.d.ts",
      "default": "./dist/tooltip/tooltip.apg.js"
    },
    "./menu": {
      "@nib-ui/source": "./src/menu/index.ts",
      "types": "./dist/menu/index.d.ts",
      "default": "./dist/menu/index.js"
    },
    "./menu/apg": {
      "@nib-ui/source": "./src/menu/menu.apg.ts",
      "types": "./dist/menu/menu.apg.d.ts",
      "default": "./dist/menu/menu.apg.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:core",
      "scope:public"
    ],
    "targets": {
      "size-limit": {
        "command": "size-limit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "{projectRoot}/.size-limit.js",
          "{workspaceRoot}/size-budgets.json"
        ]
      }
    }
  }
}
