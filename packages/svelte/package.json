{
  "name": "@nib-ui/svelte",
  "version": "0.0.0",
  "description": "Nib Svelte binding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nib-ui/nib.git",
    "directory": "packages/svelte"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nib-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./listbox": {
      "@nib-ui/source": "./src/listbox.ts",
      "types": "./dist/listbox.d.ts",
      "default": "./dist/listbox.js"
    },
    "./disclosure": {
      "@nib-ui/source": "./src/disclosure.ts",
      "types": "./dist/disclosure.d.ts",
      "default": "./dist/disclosure.js"
    },
    "./tabs": {
      "@nib-ui/source": "./src/tabs.ts",
      "types": "./dist/tabs.d.ts",
      "default": "./dist/tabs.js"
    },
    "./popover": {
      "@nib-ui/source": "./src/popover.ts",
      "types": "./dist/popover.d.ts",
      "default": "./dist/popover.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "nx": {
    "tags": [
      "type:binding",
      "scope:public"
    ],
    "targets": {
      "size-limit": {
        "command": "size-limit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "{projectRoot}/.size-limit.js",
          "{workspaceRoot}/size-budgets.json"
        ]
      }
    }
  },
  "dependencies": {
    "@nib-ui/core": "workspace:*",
    "@nib-ui/dom": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@nib-ui/test-harness": "workspace:*"
  }
}
