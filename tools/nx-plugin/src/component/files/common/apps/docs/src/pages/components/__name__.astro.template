---
import ComponentPage from '../../layouts/component-page.astro';

const code = {
  html: `<div class="nib-<%= name %>"<% if (interactive) { %> data-nib="<%= name %>"<% } %>><%= title %></div>`,<% if (interactive) { %>
  react: `import { use<%= pascal %> } from '@nib-ui/react/<%= name %>';

const <%= camel %> = use<%= pascal %>();
return <div className="nib-<%= name %>" {...<%= camel %>.part('root')}><%= title %></div>;`,
  vue: `import { use<%= pascal %> } from '@nib-ui/vue/<%= name %>';

const <%= camel %> = use<%= pascal %>();
// <div class="nib-<%= name %>" v-bind="<%= camel %>.part('root')"><%= title %></div>`,
  svelte: `import { <%= camel %> } from '@nib-ui/svelte/<%= name %>';

const view = <%= camel %>({ id: $props.id() });
// <div class="nib-<%= name %>" {...$view.part('root')}><%= title %></div>`,<% } %>
};
---

<ComponentPage
  title="<%= title %>"
  lead="One sentence on what <%= title.toLowerCase() %> is for and when to reach for it."
  kind="<%= interactive ? 'INTERACTIVE' : 'CSS' %>"
  code={code}
>
  <div slot="example" class="nib-<%= name %>"<% if (interactive) { %> data-nib="<%= name %>"<% } %>><%= title %></div>
  <h2>Usage</h2>
  <p>When to use it, its variants, and what not to do with it.</p>
  <ul slot="accessibility">
    <li>The WAI-ARIA pattern it follows<% if (interactive) { %>, and every key it handles<% } %>.</li>
    <li>What screen readers announce, and what authors must label.</li>
  </ul>
</ComponentPage>
<% if (interactive) { %>
<script>
  import '@nib-ui/js/<%= name %>';
  import { init } from '@nib-ui/js';

  init();
</script>
<% } %>
