{
  "name": "@nib-ui/stylelint-plugin",
  "version": "0.0.0",
  "description": "Stylelint rules that enforce the Nib laws",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nib-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "@nib-ui/source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "nx": {
    "tags": [
      "type:tool",
      "scope:private"
    ]
  },
  "peerDependencies": {
    "postcss": "^8.5.0",
    "stylelint": "^17.0.0"
  },
  "devDependencies": {
    "postcss": "8.5.31"
  }
}
