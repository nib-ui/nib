{
  "name": "@nib-ui/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "e2e": "scripts/playwright-docker.sh",
    "update-snapshots": "scripts/playwright-docker.sh --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@nx/devkit": "24.0.1",
    "@nx/eslint": "24.0.1",
    "@nx/eslint-plugin": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/vitest": "24.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.5",
    "astro": "7.4.2",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "jsonc-eslint-parser": "3.3.0",
    "lightningcss": "1.33.0",
    "lint-staged": "17.6.0",
    "nib": "workspace:@nib-ui/nx-plugin@*",
    "nx": "24.0.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "14.3.0",
    "stylelint": "17.16.0",
    "svelte": "5.57.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml,svelte,vue,html,astro}": "prettier --write"
  }
}
